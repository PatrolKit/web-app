# ============================================================
# PatrolKit — Environment Variables
# Copy to .env and fill in values for your environment.
# NEVER commit .env to source control.
# ============================================================

# --- Database -----------------------------------------------
# Prisma MySQL connection string
# Local dev: docker-compose MySQL (see docker/docker-compose.yml)
DATABASE_URL=mysql://patrolkit:patrolkit@localhost:3306/patrolkit

# --- JWT (EdDSA / Ed25519) ----------------------------------
# Base64-encoded Ed25519 private key (PEM). Generate per environment.
# In AWS, these are stored in Secrets Manager.
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_ED25519_PRIVATE_KEY_PEM
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY_PEM

# Token lifetimes (in seconds unless noted)
ACCESS_TOKEN_TTL=900          # 15 minutes
REFRESH_TOKEN_TTL=2592000     # 30 days
DEVICE_TOKEN_TTL=3600         # 1 hour

# Magic-link expiry (in seconds)
MAGIC_LINK_TTL=900            # 15 minutes

# --- URLs ---------------------------------------------------
# Public web URL (used in magic-link emails)
APP_URL=http://localhost:3000
# Public API base URL (same origin in production)
API_URL=http://localhost:4000

# --- Email --------------------------------------------------
# Transport: "ses" (production) | "smtp" (local Mailpit)
MAIL_TRANSPORT=smtp

# Sender address
EMAIL_FROM=noreply@patrolkit.io

# SMTP settings (used when MAIL_TRANSPORT=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Cookies ------------------------------------------------
# Cookie domain (blank for localhost; "patrolkit.io" in production)
COOKIE_DOMAIN=

# --- AWS (production / staging only) -----------------------
AWS_REGION=us-east-2
SES_REGION=us-east-2

# --- Seed ---------------------------------------------------
# Email of the bootstrap super admin (created or promoted on seed)
SEED_SUPERADMIN_EMAIL=admin@example.com

# --- App ----------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Ski Swap -----------------------------------------------
# 32-byte hex key for AES-256-GCM encryption of Square access tokens
# Generate with: openssl rand -hex 32
SQUARE_ENCRYPTION_KEY=replace_with_32_byte_hex_key
