# ============================================================
# PatrolKit — environment variables
# Copy to apps/api/.env for local development (scripts/dev-setup.mjs does),
# or to the server's .env in production. Never commit a filled-in copy.
# The defaults below work with the local docker-compose services.
# ============================================================

# --- Database -----------------------------------------------
# MySQL 8. Locally: the docker-compose MySQL. In production: e.g. Amazon RDS.
DATABASE_URL=mysql://patrolkit:patrolkit@localhost:3306/patrolkit

# --- Sign-in tokens (EdDSA / Ed25519) -----------------------
# Base64-encoded PEM keys. Generate a pair per environment: node scripts/gen-keys.mjs
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_ED25519_PRIVATE_KEY_PEM
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY_PEM

# Lifetimes, in seconds
ACCESS_TOKEN_TTL=900          # 15 minutes
REFRESH_TOKEN_TTL=2592000     # 30 days
DEVICE_TOKEN_TTL=3600         # 1 hour
MAGIC_LINK_TTL=900            # 15 minutes: sign-in links and codes

# --- URLs ---------------------------------------------------
# The staff app's public URL: sign-in links and invites point here.
APP_URL=http://localhost:3000
# The seller-facing site's public URL: check-in sign-in links and receipt QR codes.
SELLER_SITE_URL=http://localhost:3000
# The same URL, baked into the web bundle when it's built.
VITE_SELLER_SITE_URL=http://localhost:3000
# Cookie domain: blank for localhost; your apex domain in production (e.g. example.org).
COOKIE_DOMAIN=

# --- Outbound email and SMS ---------------------------------
# Fail-closed: anything but "on" delivers nothing, and the sign-in page shows
# the code instead, which is the normal local flow.
OUTBOUND_NOTIFICATIONS=off

# Email transport: "smtp" (local Mailpit) or "ses" (production)
MAIL_TRANSPORT=smtp
# Sender address. With SES, a verified identity.
EMAIL_FROM=noreply@example.org
# Used when MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# --- AWS (production) ---------------------------------------
# Credentials come from the EC2 instance role, never from this file.
AWS_REGION=us-east-2
SES_REGION=us-east-2
# Optional. An SNS origination number (e.g. a registered toll-free number) for
# texted sign-in codes, US and Canadian numbers only. Blank: no texts are sent.
AWS_SNS_ORIGINATION_NUMBER=

# Optional. S3 for item photos and org logos, served from PHOTO_BASE_URL.
# Blank: logos are stored in the database, and item photos go only to the item in Square.
PHOTO_BUCKET=
PHOTO_BASE_URL=
# Optional. S3 bucket of firmware images for print and scanner bridges (index.json at its root).
DEVICE_IMAGE_BUCKET=

# --- Ski swap -----------------------------------------------
# 32-byte hex key that encrypts each org's Square access token at rest.
# Generate with: openssl rand -hex 32. Changing it orphans every stored token.
SQUARE_ENCRYPTION_KEY=replace_with_32_byte_hex_key

# --- Seed ---------------------------------------------------
# The platform's first super admin, created (or promoted) by the seed.
SEED_SUPERADMIN_EMAIL=admin@example.org

# --- App ----------------------------------------------------
NODE_ENV=development
PORT=4000
