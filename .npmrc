# Install scripts run only for the packages listed under allowBuilds and
# onlyBuiltDependencies in pnpm-workspace.yaml.

# Font Awesome Pro. The token goes in your user-level config, never here:
#   pnpm config set "//npm.fontawesome.com/:_authToken" <your Font Awesome package token>
@awesome.me:registry=https://npm.fontawesome.com/
@fortawesome:registry=https://npm.fontawesome.com/
