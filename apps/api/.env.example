# ============================================================
# PatrolKit — Environment Variables
# Copy to .env and fill in values for your environment.
# NEVER commit .env to source control.
# ============================================================

# --- Database -----------------------------------------------
# Prisma MySQL connection string
# Local dev: docker-compose MySQL (see docker-compose.yml)
DATABASE_URL=mysql://patrolkit:patrolkit@localhost:3306/patrolkit

# --- JWT (EdDSA / Ed25519) ----------------------------------
# Base64-encoded Ed25519 keys (PEM). Generate per environment.
# In AWS, these are stored in Secrets Manager.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
DEVICE_TOKEN_TTL=3600

# --- URLs ---------------------------------------------------
# Public web URL (used in sign-in links)
APP_URL=http://localhost:3000
# Public API base URL (same origin in production)
API_URL=http://localhost:4000

# --- Notifications ------------------------------------------
# Master kill switch for ALL outbound email and SMS, read by both
# MailService and SmsService. Fail-closed: unless this is exactly "on",
# nothing is delivered and each send is logged and dropped.
#
# PRODUCTION MUST SET THIS TO "on". Nothing else turns it on, and the
# failure mode of forgetting is silence rather than a mis-sent invite.
#
# While it is off, sign-in codes are returned in the API response and
# shown on the login page, so local dev works without any mail server.
OUTBOUND_NOTIFICATIONS=off

# --- Email --------------------------------------------------
# Transport: "ses" (production) | "smtp" (local Mailpit)
MAIL_TRANSPORT=smtp
EMAIL_FROM=noreply@patrolkit.io
# SMTP settings (used when MAIL_TRANSPORT=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025

# --- SMS ----------------------------------------------------
# Origination number for AWS SNS. Leave blank to log instead of sending,
# which is a second, independent guard beneath OUTBOUND_NOTIFICATIONS.
AWS_SNS_ORIGINATION_NUMBER=

# --- Cookies ------------------------------------------------
# Cookie domain (blank for localhost; "patrolkit.io" in production)
COOKIE_DOMAIN=

# --- AWS (production / staging only) ------------------------
AWS_REGION=us-east-2
SES_REGION=us-east-2

# --- Ski Swap -----------------------------------------------
# 32-byte hex key used to encrypt stored Square access tokens
SQUARE_ENCRYPTION_KEY=
PHOTO_BUCKET=
PHOTO_BASE_URL=

# --- Seed ---------------------------------------------------
# Email of the bootstrap super admin (created or promoted on seed)
SEED_SUPERADMIN_EMAIL=admin@example.com

# --- App ----------------------------------------------------
NODE_ENV=development
PORT=4000
