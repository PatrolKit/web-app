{
  "name": "@patrolkit/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:int": "jest --config jest.integration.js --forceExit --runInBand",
    "test:cov": "jest --coverage",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:export-taxonomy": "ts-node --project prisma/tsconfig.seed.json prisma/export-taxonomy.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/client-ses": "^3.0.0",
    "@aws-sdk/client-sns": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@fontsource/inter": "^5.3.0",
    "@napi-rs/canvas": "^1.0.8",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@paralleldrive/cuid2": "^2.2.0",
    "@prisma/client": "^5.0.0",
    "@types/sharp": "^0.32.0",
    "argon2": "^0.41.0",
    "cookie-parser": "^1.4.0",
    "csv-parse": "^5.5.0",
    "express": "^4.22.1",
    "helmet": "^8.0.0",
    "html-to-text": "^9.0.5",
    "jose": "^5.0.0",
    "nestjs-pino": "^4.0.0",
    "nestjs-zod": "^3.0.0",
    "nodemailer": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "prisma": "^5.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sanitize-html": "2.17.0",
    "sharp": "^0.33.0",
    "square": "^45.0.1",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.5.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@testcontainers/mysql": "^10.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^4.17.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^29.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pino": "^7.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "pino-pretty": "^11.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.0.0",
    "ts-jest": "^29.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  }
}
