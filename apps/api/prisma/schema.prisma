datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Identity ─────────────────────────────────────────────────────────────────

/// The person. One row per human (or, for a business seller invited by email,
/// one row per mailbox until someone claims it). Everything a person *is* lives
/// here; everything they are *to an org* lives on Membership.
model User {
  id String @id @default(cuid())

  /// Both nullable: a walk-in known only by a phone number has neither.
  firstName String?
  lastName  String?

  /// Issued nationally, one per human — a matching key, never an auth key.
  /// Normalised by `normalizeNspId`: non-alphanumerics stripped, upper-cased,
  /// leading zeros preserved.
  nspId       String? @unique
  patrolLevel String?

  // Global: these describe the human, not one relationship.
  street String?
  city   String?
  state  String?
  zip    String?

  payoutMethod String? @default("CHECK") // PAYPAL | VENMO | CHECK | DONATE

  /// What kind of destination the money goes to, and therefore how a payout run
  /// addresses it. Null for CHECK and DONATE.
  ///
  ///   EMAIL | PHONE  — the seller's own verified contact
  ///   PAYPAL_ID      — a PayPal account they typed
  ///   VENMO_ID       — a Venmo account they typed
  ///
  /// The first three are PayPal Payouts' own recipient types, which is why this
  /// is a discriminator rather than free text: the payment run has to tell them
  /// apart. It also records whether the destination was proven or self-asserted,
  /// without a second field that could drift out of step with this one.
  payoutTarget String? @db.VarChar(16)

  /// The typed value, for PAYPAL_ID and VENMO_ID only. Null for EMAIL and PHONE,
  /// where the destination resolves from `verifiedEmail` / `verifiedPhone` when
  /// the money moves — storing a copy would let someone change their email and
  /// leave the payout pointed at the old one.
  payoutHandle String?

  /// Claims. Indexed for matching, deliberately NOT unique — an unverified
  /// claim may collide with another unverified claim.
  email           String?
  emailVerifiedAt DateTime?
  /// Mirror of `email`, written only when verified. The unique index is what
  /// enforces "at most one person may hold a verified claim to a contact".
  verifiedEmail   String?   @unique

  /// E.164 normalised.
  phone           String?
  phoneVerifiedAt DateTime?
  /// Mirror of `phone`, written only when verified.
  verifiedPhone   String?   @unique

  isSuperAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  challenges    ContactChallenge[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([phone])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  orgModules      OrgModule[]
  devices         Device[]
  squareConfig    SquareConfig?
  skiSwaps        SkiSwap[]
  swapItems       SwapItem[]
  swapPrinters    SwapPrinter[]
  skiSwapSettings SkiSwapSettings?
  checkinStations CheckinStation[]
  printJobs       PrintJob[]

  resorts           Resort[]
  timeClockEvents   TimeClockEvent[]
  timeClockShifts   TimeClockShift[]
  timeClockSettings TimeClockSettings?
}

/// The person, to an organisation. The single org-scoped person record: roles
/// hang off it as profiles, permissions as grants. `deletedAt` is the only
/// lifecycle field — there is no separate "disabled" status.
model Membership {
  id       String   @id @default(cuid())
  userId   String
  orgId    String
  joinedAt DateTime @default(now())

  /// Delta-sync watermark covering User + Membership + profiles. Deliberately
  /// NOT `@updatedAt`: a rename on User must bump it, which Prisma cannot do.
  /// Maintained by MembershipTouchService.
  updatedAt DateTime  @default(now())
  /// Soft removal. Memberships are never hard-deleted — offline devices need
  /// the tombstone to learn that someone left the roster.
  deletedAt DateTime?

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions MembershipPermission[]

  sellerProfile    SellerProfile?
  patrollerProfile PatrollerProfile?

  @@unique([userId, orgId])
  @@index([orgId, updatedAt])
  @@index([orgId, deletedAt])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  memberships MembershipPermission[]
}

model MembershipPermission {
  membershipId String
  permissionId String
  grantedAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([membershipId, permissionId])
}

// ─── Contact proof ────────────────────────────────────────────────────────────

/// One primitive for proving control of a contact channel. Replaces MagicLink
/// and SellerVerification. Confirming a challenge always stamps the contact
/// verified, and mints a session when `purpose` allows.
///
/// Lookup is always by `id`, never by hash: a 32-byte email token and a 6-digit
/// OTP share this table, and a unique index on `codeHash` cannot work for OTPs.
model ContactChallenge {
  id      String @id @default(cuid())
  userId  String
  channel String // email | phone
  /// Snapshot of the address being proven, so editing the contact cannot
  /// retarget a live challenge.
  target  String
  /// login | verify | invite — controls TTL and whether confirmation mints a session.
  purpose String

  codeHash String
  /// Capped at 5. A 6-digit OTP needs a per-challenge counter, not just an IP throttle.
  attempts Int    @default(0)

  /// What this sign-in was for, so the session can resume it whichever browser
  /// context confirms. Structured and server-interpreted — never a URL, and
  /// never read from the query string.
  context Json?

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, usedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Modules, devices, audit ──────────────────────────────────────────────────

model ModuleCatalog {
  key         String  @id
  name        String
  description String
  isCore      Boolean @default(false)

  orgModules OrgModule[]
}

model OrgModule {
  id        String    @id @default(cuid())
  orgId     String
  moduleKey String
  enabled   Boolean   @default(false)
  enabledAt DateTime?
  enabledBy String?
  updatedAt DateTime  @updatedAt

  org    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module ModuleCatalog @relation(fields: [moduleKey], references: [key])

  @@unique([orgId, moduleKey])
}

model Device {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  clientId   String    @unique
  secretHash String
  /// Authorises the device on its own. There is no per-device permission set —
  /// a device's job is its role.
  role       String    @db.VarChar(100)
  lastSeenAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())

  /// Last reported state of a bridge's BLE link to its printer: ready | down.
  /// Null for every other kind of device, and for a bridge that has not yet
  /// reported one. Reported on the claim, so it costs no extra request.
  printerLink   String?   @db.VarChar(16)
  /// When that report arrived. A stale `ready` means nothing — the bridge could
  /// have lost power holding it — so the age is as load-bearing as the value.
  printerLinkAt DateTime?

  /// The resort this terminal clocks people in at. Meaningful only for
  /// `time_clock.terminal`, the way `printerLink` is meaningful only for a
  /// bridge.
  ///
  /// It lives here rather than on `Resort` because it is many-to-one: a big
  /// base area runs several iPads. A station's binding sits the other way round
  /// on `CheckinStation` because a counter has exactly one attendant tablet.
  resortId String?

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: retiring a resort must not delete the hardware
  /// standing in it. The tablet stays, unbound, and can be pointed somewhere
  /// else.
  resort          Resort?         @relation(fields: [resortId], references: [id], onDelete: SetNull)
  attendedStation CheckinStation? @relation("StationAttendant")
  bridgedStation  CheckinStation? @relation("StationBridge")
  /// The printer this bridge drives. Only a bridge ever has one.
  bridgedPrinter  SwapPrinter?    @relation("BridgedPrinter")

  /// What an image-based device last told us about itself, from the headers on
  /// its bootstrap check-in. Meaningful only for devices running the PatrolKit
  /// device image, the way `printerLink` is meaningful only for a bridge.
  ///
  /// Recorded verbatim and never parsed for authorization: this is the only
  /// view anyone has of what a display is actually running, and "provisioned"
  /// and "running the right software" are different claims.
  hardwareId        String?   @db.VarChar(128)
  imageName         String?   @db.VarChar(128)
  imageVersion      String?   @db.VarChar(64)
  /// The raw `name=version,…` header. Displayed, never queried — a device with
  /// two packages is the normal case and a join table would be three tables to
  /// render one line of text.
  installedPackages String?   @db.Text
  /// The last manifest fetch, including the 304s. Steady state is almost
  /// entirely 304s, so a `bootstrapAt` that only moved on 200s would look like
  /// a device that had stopped calling in.
  bootstrapAt       DateTime?

  /// The composite unique on (orgId, skiSwapDeviceCode) used to double as the
  /// index MySQL requires behind the orgId foreign key. With the code gone,
  /// orgId needs one of its own — dropping the composite without this fails.
  @@index([orgId])
  @@index([resortId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // user | device | system
  actorId    String?
  orgId      String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
}

model IdempotencyRecord {
  key       String   @id
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ─── Ski Swap ─────────────────────────────────────────────────────────────────

model SquareConfig {
  id             String   @id @default(cuid())
  orgId          String   @unique
  accessTokenEnc String   @db.Text // AES-256-GCM JSON: { iv, tag, ct }
  environment    String   @default("production") // "sandbox" | "production"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model SkiSwap {
  id               String   @id @default(cuid())
  orgId            String
  title            String
  squareCategoryId String
  locationId       String   @default("") // Square Location ID for inventory ops
  active           Boolean  @default(false)
  skuPrefix        String
  /// Mirror of skuPrefix, written only while the swap is active. MySQL allows
  /// many NULLs in a unique index, so inactive swaps never collide — which is
  /// what stops two live swaps issuing the same SKU.
  activeSkuPrefix  String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items       SwapItem[]
  skuCounters SwapSkuCounter[]

  @@unique([orgId, title])
  @@unique([orgId, activeSkuPrefix])
  @@index([orgId, active])
}

/// The seller role, granted on a membership. Deliberately thin: person data
/// lives on User. What keeps it a table is its id — which anchors
/// SwapItem.sellerId, SwapPrinter.assignedSellerId and the public /s/:sellerId
/// URL — and `deletedAt`, which grants and revokes the role.
model SellerProfile {
  id           String @id @default(cuid())
  membershipId String @unique

  /// Set ⇒ this membership sells on behalf of a business; null ⇒ individual.
  /// Replaces the old `type` enum, so the two can no longer contradict.
  businessName String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  membership       Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  swapItems        SwapItem[]
  assignedPrinters SwapPrinter[]
}

model SwapItem {
  id               String  @id @default(cuid())
  swapId           String
  orgId            String
  sellerId         String?
  name             String
  description      String? @db.Text
  priceCents       Int
  sku              String
  originalQuantity Int

  // Square sync state — null when Square is not configured
  squareItemId      String?
  squareVariationId String?
  lastSyncedAt      DateTime?
  donateProceeds    Boolean   @default(false)
  hasPrintedTag     Boolean   @default(false)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  swap   SkiSwap         @relation(fields: [swapId], references: [id], onDelete: Cascade)
  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  seller SellerProfile?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  photos SwapItemPhoto[]

  @@unique([swapId, sku])
  @@index([orgId])
  @@index([sellerId])
}

model SwapItemPhoto {
  id            String   @id @default(cuid())
  itemId        String
  s3Key         String   @default("") // empty when S3 not configured
  url           String
  squareImageId String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  item SwapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model SwapPrinter {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  bluetoothName    String
  paperSize        String   @default("40x30") // "40x30" | "50x30"
  marginTop        Int      @default(4)
  marginBottom     Int      @default(4)
  marginLeft       Int      @default(8)
  marginRight      Int      @default(16)
  /// Set ⇒ this printer belongs to one business seller, and cannot also be
  /// driven by a bridge. A printer serves exactly one thing.
  assignedSellerId String?
  /// The bridge that drives this printer. Unique: a printer is a single BLE
  /// peripheral and whoever holds the link owns it, so two bridges pointed at
  /// one would fight over it. A station reaches its printer through its bridge.
  bridgeDeviceId   String?  @unique
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  seller SellerProfile? @relation(fields: [assignedSellerId], references: [id], onDelete: SetNull)
  bridge Device?        @relation("BridgedPrinter", fields: [bridgeDeviceId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([assignedSellerId])
}

/// A place a seller checks themselves in: a QR code and a printer, with a bridge
/// between. The station is the layer that survives replacing either piece of
/// hardware beneath it, which is why it owns the SKU namespace character.
model CheckinStation {
  id    String @id @default(cuid())
  orgId String
  /// Human label — "Station 3".
  name  String
  /// One character, unique per org. The SKU namespace for everything checked in
  /// here, staffed or self-service, and however the tag was printed. The only
  /// consumer of the pool.
  code  String @db.VarChar(1)

  /// The staff tablet stationed at this counter. Its presence is what makes the
  /// station staffed rather than self-service — a stored `kind` could contradict
  /// the hardware attached to it, so the kind is derived instead.
  attendantDeviceId String?   @unique
  /// The bridge that prints for this station. Re-bindable: hardware dies
  /// mid-swap, and queued jobs survive because they belong to the station, not
  /// the bridge. Required for self-service, where a seller has no other way to
  /// get a tag; optional for staffed, where the tablet can print over Bluetooth.
  bridgeDeviceId    String?   @unique
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendant Device?      @relation("StationAttendant", fields: [attendantDeviceId], references: [id], onDelete: SetNull)
  bridge    Device?      @relation("StationBridge", fields: [bridgeDeviceId], references: [id], onDelete: SetNull)
  printJobs PrintJob[]

  @@unique([orgId, code])
  @@index([orgId, deletedAt])
}

/// A label waiting to print. Holds a recipe rather than bytes: the raster is
/// rendered when the job is claimed, so a job adapts to whichever printer is
/// actually attached at that moment.
model PrintJob {
  id        String  @id @default(cuid())
  orgId     String
  /// Where the job goes.
  stationId String
  /// Which printer it was queued against. Diagnostics only — the render
  /// resolves the station's current printer at claim time.
  printerId String?

  /// Set when a job belongs to a check-in; null for staff-initiated work.
  swapId   String?
  sellerId String?
  /// The item this tag depicts. Null for receipts and calibration. What lets an
  /// ack flip SwapItem.hasPrintedTag once every tag for that item has printed.
  itemId   String?

  /// item | receipt_header | receipt_items | qr | calibration
  kind   String
  /// Anything the recipe needs beyond the ids above — the page index of a
  /// paginated receipt, the text of a QR label.
  params Json?
  /// Ordering within one seller's batch, so tags emerge in entry order.
  seq    Int    @default(0)

  /// queued | claimed | printed | failed | abandoned
  status     String    @default("queued")
  claimToken String?
  claimedAt  DateTime?
  /// Claim expiry. A job past this with status=claimed returns to the queue.
  claimUntil DateTime?
  printedAt  DateTime?
  attempts   Int       @default(0)
  lastError  String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  station CheckinStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, status, seq])
  @@index([status, claimUntil])
  @@index([itemId, status])
  @@index([orgId, createdAt])
}

/// One SKU counter per minting endpoint per swap, so stations never contend.
/// `code` is a station code or a check-in device code — one shared per-org pool.
model SwapSkuCounter {
  id          String @id @default(cuid())
  swapId      String
  code        String @db.VarChar(1)
  lastCounter Int    @default(0)

  swap SkiSwap @relation(fields: [swapId], references: [id], onDelete: Cascade)

  @@unique([swapId, code])
}

model SkiSwapSettings {
  id            String   @id @default(cuid())
  orgId         String   @unique
  labelsPerItem Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─── Time Clock ───────────────────────────────────────────────────────────────

model Resort {
  id        String    @id @default(cuid())
  orgId     String
  name      String
  street    String?
  city      String?
  state     String?
  zip       String?
  /// IANA zone derived from the address; shift arithmetic depends on it.
  timeZone  String    @default("America/New_York")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shifts  TimeClockShift[]
  events  TimeClockEvent[]
  /// The terminals standing at this resort. Several is normal.
  devices Device[]

  @@index([orgId, deletedAt])
  @@index([orgId, updatedAt])
}

/// The patroller role, granted on a membership. Deliberately thin: nspId,
/// patrolLevel and the person's name live on User. `active` is genuinely
/// org-scoped — on the roster at this mountain, but not currently patrolling.
model PatrollerProfile {
  id           String @id @default(cuid())
  membershipId String @unique

  active Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  membership Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  shifts     TimeClockShift[]
  events     TimeClockEvent[]
}

model TimeClockEvent {
  id          String   @id
  orgId       String
  resortId    String
  patrollerId String
  deviceId    String?
  type        String
  dutyType    String?
  dutyNote    String?  @db.VarChar(120)
  source      String   @default("device")
  occurredAt  DateTime
  recordedAt  DateTime @default(now())
  clockSkewMs Int?
  status      String   @default("applied")
  statusNote  String?

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resort    Resort           @relation(fields: [resortId], references: [id])
  patroller PatrollerProfile @relation(fields: [patrollerId], references: [id])

  @@index([orgId, patrollerId, occurredAt])
  @@index([orgId, status])
  @@index([resortId])
}

model TimeClockShift {
  id             String    @id
  orgId          String
  resortId       String
  patrollerId    String
  dutyType       String
  dutyNote       String?   @db.VarChar(120)
  clockInAt      DateTime
  clockOutAt     DateTime?
  status         String
  closeReason    String?
  flagged        Boolean   @default(false)
  editedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resort    Resort           @relation(fields: [resortId], references: [id])
  patroller PatrollerProfile @relation(fields: [patrollerId], references: [id])

  @@index([orgId, resortId, status])
  @@index([orgId, updatedAt])
  @@index([orgId, patrollerId, status])
  @@index([resortId])
  @@index([patrollerId])
}

model TimeClockSettings {
  id                  String   @id @default(cuid())
  orgId               String   @unique
  autoCloseLocalTime  String   @default("03:00")
  autoCloseAfterHours Int      @default(4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─── Device bootstrap ─────────────────────────────────────────────────────────

/// An apt repository a device may install from.
///
/// Platform-scoped, deliberately: there is no `orgId` because the fleet installs
/// PatrolKit's software from PatrolKit's repository. An org that could name its
/// own repository could install its own software on hardware we support.
model BootstrapRepository {
  id String @id @default(cuid())

  /// The apt source name. Constrained to `[a-z0-9][a-z0-9-]*` by the device's
  /// own schema, so it is validated on the way in rather than discovered on the
  /// way out.
  name       String @unique @db.VarChar(64)
  uri        String @db.VarChar(512)
  suite      String @db.VarChar(64)
  /// Comma-separated on the way in, rendered as a JSON array on the way out.
  /// One row per component would be a table to hold the word "main".
  components String @db.VarChar(255)
  arch       String @default("arm64") @db.VarChar(16)

  /// The signing key fingerprint the device must already carry.
  ///
  /// The server cannot validate this and must not pretend to: every key a
  /// device will ever honour is baked into its image at build time, and a
  /// manifest naming any other is rejected outright — silently, on the device,
  /// with no error path back here. A typo takes out every device of every role
  /// that names this repository.
  signedByKeyId String @db.VarChar(64)
  /// apt pin priority, when a repository must win or lose against another.
  pinPriority   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles BootstrapProfile[]
}

/// What one device role runs. One row per role, platform-wide.
///
/// This is the record that makes the device image generic in fact rather than
/// in principle — it is where "this device is a signage device, here is the
/// package and version to run" is expressed, instead of being baked into an
/// image at build time.
model BootstrapProfile {
  id String @id @default(cuid())

  /// The `Device.role` this serves, e.g. `signage.display`.
  role       String @unique @db.VarChar(100)
  /// Informational, passed through as `manifest.deviceType`. The image never
  /// branches on it.
  deviceType String @db.VarChar(64)

  /// Off serves a 404, which a device answers by keeping the manifest it has.
  /// Deleting the profile would do the same thing and lose the configuration.
  enabled Boolean @default(true)

  updateEnabled      Boolean @default(true)
  /// `HH:MM-HH:MM` local to the device, or null to leave the image's own
  /// configured window in force.
  updateWindow       String? @db.VarChar(16)
  checkinIntervalSec Int     @default(3600)

  /// Counts edits, not resolutions.
  ///
  /// A package that tracks latest changes what is served with no edit behind
  /// it, so this cannot be the cache key — the ETag over the resolved manifest
  /// is. Devices diff package versions and never read this, so the two moving
  /// independently costs nothing.
  manifestVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Rendered in name order, so editing an unrelated repository cannot churn
  /// the ETag and wake up a fleet.
  repositories BootstrapRepository[]
  packages     BootstrapPackage[]
}

/// One package a role installs, pinned or tracking.
model BootstrapPackage {
  id        String @id @default(cuid())
  profileId String

  name    String  @db.VarChar(128)
  /// The pinned version, or null to track the newest in the repository.
  ///
  /// The device diffs version strings and treats any difference as work to do,
  /// in either direction — a manifest that pins backwards is a deliberate
  /// rollback and is honoured as one.
  version String? @db.VarChar(64)

  /// What tracking last resolved to, and when.
  ///
  /// Durable rather than merely cached: it is what gets served when the apt
  /// index is unreachable. Without it, a repository having a bad five minutes
  /// would stop every device of this role checking in.
  resolvedVersion String?   @db.VarChar(64)
  resolvedAt      DateTime?

  /// Render order. Cosmetic to the device, which installs the set, but it keeps
  /// the manifest bytes — and therefore the ETag — stable across edits.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile BootstrapProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}
