datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Identity ─────────────────────────────────────────────────────────────────

/// The person. One row per human (or, for a business seller invited by email,
/// one row per mailbox until someone claims it). Everything a person *is* lives
/// here; everything they are *to an org* lives on Membership.
model User {
  id String @id @default(cuid())

  /// Both nullable: a walk-in known only by a phone number has neither.
  firstName String?
  lastName  String?

  /// Issued nationally, one per human — a matching key, never an auth key.
  /// Normalised by `normalizeNspId`: non-alphanumerics stripped, upper-cased,
  /// leading zeros preserved.
  nspId       String? @unique
  patrolLevel String?

  // Global: these describe the human, not one relationship.
  street String?
  city   String?
  state  String?
  zip    String?

  payoutMethod String? @default("CHECK") // PAYPAL | VENMO | CHECK | DONATE

  /// What kind of destination the money goes to, and therefore how a payout run
  /// addresses it. Null for CHECK and DONATE.
  ///
  ///   EMAIL | PHONE  — the seller's own verified contact
  ///   PAYPAL_ID      — a PayPal account they typed
  ///   VENMO_ID       — a Venmo account they typed
  ///
  /// The first three are PayPal Payouts' own recipient types, which is why this
  /// is a discriminator rather than free text: the payment run has to tell them
  /// apart. It also records whether the destination was proven or self-asserted,
  /// without a second field that could drift out of step with this one.
  payoutTarget String? @db.VarChar(16)

  /// The typed value, for PAYPAL_ID and VENMO_ID only. Null for EMAIL and PHONE,
  /// where the destination resolves from `verifiedEmail` / `verifiedPhone` when
  /// the money moves — storing a copy would let someone change their email and
  /// leave the payout pointed at the old one.
  payoutHandle String?
  /// When `payoutHandle` was read from the seller's Venmo code, scanned at the
  /// counter (Plan 35). Only a scanned Venmo account is paid: a typed one is
  /// only somebody's word for it. Cleared when the handle goes.
  payoutHandleScannedAt DateTime?

  /// Claims. Indexed for matching, deliberately NOT unique — an unverified
  /// claim may collide with another unverified claim.
  email           String?
  emailVerifiedAt DateTime?
  /// Mirror of `email`, written only when verified. The unique index is what
  /// enforces "at most one person may hold a verified claim to a contact".
  verifiedEmail   String?   @unique

  /// E.164 normalised.
  phone           String?
  phoneVerifiedAt DateTime?
  /// Mirror of `phone`, written only when verified.
  verifiedPhone   String?   @unique

  isSuperAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  challenges    ContactChallenge[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([phone])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended
  /// An https URL where S3 is configured, and a `data:` URI where it is not.
  ///
  /// MediumText because of the second one. The default VARCHAR(191) fits a URL
  /// and nothing else, so the data-URI branch in `uploadLogo` could never
  /// actually write — every upload on a deployment without a bucket threw on
  /// the column, which is why no logo has ever appeared in local development.
  /// Base64 of the 2 MB upload cap is about 2.7 MB, inside MediumText's 16.
  logoUrl   String?  @db.MediumText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  orgModules      OrgModule[]
  devices         Device[]
  squareConfig    SquareConfig?
  skiSwaps        SkiSwap[]
  swapItems       SwapItem[]
  swapPrinters    SwapPrinter[]
  swapScanners    SwapScanner[]
  skiSwapSettings SkiSwapSettings?
  taxonomyNodes   TaxonomyNode[]
  checkinStations CheckinStation[]
  printJobs       PrintJob[]
  receipts        Receipt[]
  payPalConfig    PayPalConfig?
  payoutRuns      PayoutRun[]

  resorts           Resort[]
  timeClockEvents   TimeClockEvent[]
  timeClockShifts   TimeClockShift[]
  timeClockSettings TimeClockSettings?
}

/// The person, to an organisation. The single org-scoped person record: roles
/// hang off it as profiles, permissions as grants. `deletedAt` is the only
/// lifecycle field — there is no separate "disabled" status.
model Membership {
  id       String   @id @default(cuid())
  userId   String
  orgId    String
  joinedAt DateTime @default(now())

  /// Delta-sync watermark covering User + Membership + profiles. Deliberately
  /// NOT `@updatedAt`: a rename on User must bump it, which Prisma cannot do.
  /// Maintained by MembershipTouchService.
  updatedAt DateTime  @default(now())
  /// Soft removal. Memberships are never hard-deleted — offline devices need
  /// the tombstone to learn that someone left the roster.
  deletedAt DateTime?
  /// When this member was last emailed an invite to sign in, if ever. Only a
  /// sent email counts, not one suppressed or refused.
  inviteSentAt DateTime?

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions MembershipPermission[]

  sellerProfile    SellerProfile?
  patrollerProfile PatrollerProfile?

  @@unique([userId, orgId])
  @@index([orgId, updatedAt])
  @@index([orgId, deletedAt])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  memberships MembershipPermission[]
}

model MembershipPermission {
  membershipId String
  permissionId String
  grantedAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([membershipId, permissionId])
}

// ─── Contact proof ────────────────────────────────────────────────────────────

/// One primitive for proving control of a contact channel. Replaces MagicLink
/// and SellerVerification. Confirming a challenge always stamps the contact
/// verified, and mints a session when `purpose` allows.
///
/// Lookup is always by `id`, never by hash: a 32-byte email token and a 6-digit
/// OTP share this table, and a unique index on `codeHash` cannot work for OTPs.
model ContactChallenge {
  id      String @id @default(cuid())
  userId  String
  channel String // email | phone
  /// Snapshot of the address being proven, so editing the contact cannot
  /// retarget a live challenge.
  target  String
  /// login | verify | invite — controls TTL and whether confirmation mints a session.
  purpose String

  codeHash String
  /// Capped at 5. A 6-digit OTP needs a per-challenge counter, not just an IP throttle.
  attempts Int    @default(0)

  /// What this sign-in was for, so the session can resume it whichever browser
  /// context confirms. Structured and server-interpreted — never a URL, and
  /// never read from the query string.
  context Json?

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, usedAt])
  /// Codes per destination (Plan 26 §5) — counted whoever asked for them.
  @@index([target, createdAt])
  /// Texts per hour, site-wide (Plan 26 §7).
  @@index([channel, createdAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  /// `full`, or `checkin` for a session started at a station (Plan 33): it
  /// reaches the check-in flow only, and lives a day.
  scope     String    @default("full")
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Modules, devices, audit ──────────────────────────────────────────────────

model ModuleCatalog {
  key         String  @id
  name        String
  description String
  isCore      Boolean @default(false)

  orgModules OrgModule[]
}

model OrgModule {
  id        String    @id @default(cuid())
  orgId     String
  moduleKey String
  enabled   Boolean   @default(false)
  enabledAt DateTime?
  enabledBy String?
  updatedAt DateTime  @updatedAt

  org    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module ModuleCatalog @relation(fields: [moduleKey], references: [key])

  @@unique([orgId, moduleKey])
}

model Device {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  clientId   String    @unique
  secretHash String
  /// Authorises the device on its own. There is no per-device permission set —
  /// a device's job is its role.
  role       String    @db.VarChar(100)
  lastSeenAt DateTime?
  /// When the device last traded its client secret for a token. Only the
  /// current secret can, so one after a code was issued means that code was
  /// used: what "set up" waits for (an old iPad still on its token keeps
  /// moving `lastSeenAt`, not this).
  lastTokenAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())

  /// Last reported state of a bridge's BLE link to its printer: ready | down.
  /// Null for every other kind of device, and for a bridge that has not yet
  /// reported one. Reported on the claim, so it costs no extra request.
  printerLink   String?   @db.VarChar(16)
  /// When that report arrived. A stale `ready` means nothing — the bridge could
  /// have lost power holding it — so the age is as load-bearing as the value.
  printerLinkAt DateTime?

  /// The same three for the scanner a bridge drives. Omitted on a claim leaves
  /// the last report standing, exactly like `printerLink` — a bridge that says
  /// nothing has not said "down".
  ///
  /// A dead printer is noticed within one label. A dead scanner is noticed when
  /// somebody realises nothing has been scanned for twenty minutes, which is
  /// why these are worth carrying at all.
  scannerLink    String?   @db.VarChar(16)
  scannerLinkAt  DateTime?
  /// Percent, read from the scanner's own `180F`/`2A19` on connect — so it is
  /// stale between reconnects and means "last known", the way a `ready` that
  /// arrived an hour ago does.
  scannerBattery Int?
  /// Scans taken but not yet accepted by us. The one number that says scanning
  /// is happening and going nowhere: a `ready` link with a depth climbing off
  /// zero is an operator working normally whose work is not landing.
  scanQueueDepth Int?
  /// How often this device sends telemetry, in seconds; null is the firmware's
  /// default of 300. Turned up for one bridge during an investigation, without
  /// reflashing it. Kept within 60–3600, which the firmware clamps to anyway.
  telemetryIntervalS Int?

  /// The resort this terminal clocks people in at. Meaningful only for
  /// `time_clock.terminal`, the way `printerLink` is meaningful only for a
  /// bridge.
  ///
  /// It lives here rather than on `Resort` because it is many-to-one: a big
  /// base area runs several iPads. A station's binding sits the other way round
  /// on `CheckinStation` because a counter has exactly one attendant tablet.
  resortId String?

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: retiring a resort must not delete the hardware
  /// standing in it. The tablet stays, unbound, and can be pointed somewhere
  /// else.
  resort          Resort?         @relation(fields: [resortId], references: [id], onDelete: SetNull)
  attendedStation CheckinStation? @relation("StationAttendant")
  /// The stations this bridge prints for: one self-service station, or any
  /// number of staffed ones (Plan 27). Never a mix — see `StationService`.
  bridgedStations CheckinStation[] @relation("StationBridge")
  /// The printer this bridge drives. Only a bridge ever has one.
  bridgedPrinter  SwapPrinter?    @relation("BridgedPrinter")
  bridgedScanner  SwapScanner?    @relation("BridgedScanner")
  telemetry       DeviceTelemetry[]
  outages         DeviceOutage[]

  /// What an image-based device last told us about itself, from the headers on
  /// its bootstrap check-in. Meaningful only for devices running the PatrolKit
  /// device image, the way `printerLink` is meaningful only for a bridge.
  ///
  /// Recorded verbatim and never parsed for authorization: this is the only
  /// view anyone has of what a display is actually running, and "provisioned"
  /// and "running the right software" are different claims.
  hardwareId        String?   @db.VarChar(128)
  imageName         String?   @db.VarChar(128)
  imageVersion      String?   @db.VarChar(64)
  /// The raw `name=version,…` header. Displayed, never queried — a device with
  /// two packages is the normal case and a join table would be three tables to
  /// render one line of text.
  installedPackages String?   @db.Text
  /// The last manifest fetch, including the 304s. Steady state is almost
  /// entirely 304s, so a `bootstrapAt` that only moved on 200s would look like
  /// a device that had stopped calling in.
  bootstrapAt       DateTime?
  /// The app a staff iPad reports running, recorded on each `/devices/me`:
  /// the marketing version (CFBundleShortVersionString, "1.4.0") and the build
  /// (CFBundleVersion). Null until the device has said.
  appVersion        String?   @db.VarChar(32)
  appBuild          String?   @db.VarChar(32)

  /// The composite unique on (orgId, skiSwapDeviceCode) used to double as the
  /// index MySQL requires behind the orgId foreign key. With the code gone,
  /// orgId needs one of its own — dropping the composite without this fails.
  @@index([orgId])
  @@index([resortId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // user | device | system
  actorId    String?
  orgId      String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
}

model IdempotencyRecord {
  key       String   @id
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ─── Ski Swap ─────────────────────────────────────────────────────────────────

model SquareConfig {
  id             String   @id @default(cuid())
  orgId          String   @unique
  accessTokenEnc String   @db.Text // AES-256-GCM JSON: { iv, tag, ct }
  environment    String   @default("production") // "sandbox" | "production"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model SkiSwap {
  id                   String   @id @default(cuid())
  orgId                String
  title                String
  squareCategoryId     String
  locationId           String   @default("") // Square Location ID for inventory ops
  active               Boolean  @default(false)
  skuPrefix            String
  /// Mirror of skuPrefix, written only while the swap is active. MySQL allows
  /// many NULLs in a unique index, so inactive swaps never collide — which is
  /// what stops two live swaps issuing the same SKU.
  activeSkuPrefix      String?
  /// How items come in, said positively, per place (Plan 34). Two ways: a
  /// legacy ticket, already on the gear from the old stockpile, or a print
  /// ticket, a tag printed here. Two places: staff check-in (the iPad) and the
  /// web (a seller's own entry and uploads, and staff uploading for one).
  ///
  /// Each place takes at least one way; the server refuses a swap where a place
  /// takes neither. Legacy tickets anywhere also means ticket blocks can be
  /// issued to business sellers.
  allowLegacyCheckin   Boolean  @default(false)
  allowLegacyWeb       Boolean  @default(false)
  allowPrintCheckin    Boolean  @default(true)
  allowPrintWeb        Boolean  @default(true)
  /// Whether the staff iPad prints a helper label to go with each legacy
  /// ticket at check-in. The iPad decides what one is and prints it itself;
  /// the server keeps the switch. Only with `allowLegacyCheckin`, and cleared
  /// when that goes off.
  printLegacyHelperLabels Boolean @default(false)
  /// Price tags printed each time an item's tag is printed, 1 to 3.
  ///
  /// Per swap rather than per org: one swap's tags go on skis that get a tag
  /// at each end, another's on a single hang tag. It used to be an org setting
  /// (`SkiSwapSettings`), and each swap took that value when it moved here.
  labelsPerItem        Int      @default(1)
  /// The swap's public address, `<org>/<slug>/status` (Plan 33). Derived from
  /// the title like `skuPrefix`, lowercased, once; a rename doesn't move it.
  slug                 String
  /// Unauthenticated SKU Lookup: anyone may check one SKU's status.
  skuLookupEnabled     Boolean  @default(false)
  /// Unauthenticated Seller Status: the email and last-4 lookup, and `/s/`.
  sellerLookupEnabled  Boolean  @default(false)
  /// Authenticated Seller Status: an individual seller here may sign in.
  sellerLoginEnabled   Boolean  @default(false)
  /// What a seller's receipt is (Plan 36): ITEMIZED, STATUS_ONLY or NONE.
  receiptMode          String   @default("ITEMIZED")
  /// An itemized receipt's columns. SKU or name must stay on (D7).
  receiptShowSku       Boolean  @default(true)
  receiptShowName      Boolean  @default(true)
  receiptShowPrice     Boolean  @default(true)
  /// Which status page a receipt links to: NONE, SKU_LOOKUP, SELLER_STATUS or
  /// SELLER_LOGIN. Resolved when the receipt is shown; a page that's since
  /// been turned off gives no link (D2).
  receiptLink          String   @default("NONE")
  /// Whether receipts are printed at all, and on which stock: 62x100 or 50x30.
  receiptPrintEnabled  Boolean  @default(true)
  receiptPaperSize     String   @default("62x100")
  /// Optional fine print for the email and receipt page: sanitized HTML (D13).
  receiptFinePrintEnabled Boolean @default(false)
  receiptFinePrint     String?  @db.Text
  /// IANA zone the swap happens in: receipts give their times in it.
  timeZone             String   @default("America/New_York")
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items        SwapItem[]
  skuCounters  SwapSkuCounter[]
  receipts     Receipt[]
  payoutRuns   PayoutRun[]
  diagnosticRuns   SwapDiagnosticRun[]
  diagnosticHidden SwapDiagnosticHidden[]

  @@unique([orgId, title])
  @@unique([orgId, activeSkuPrefix])
  @@unique([orgId, slug])
  @@index([orgId, active])
}

/// The seller role, granted on a membership. Deliberately thin: person data
/// lives on User. What keeps it a table is its id — which anchors
/// SwapItem.sellerId, SwapPrinter.assignedSellerId and the public /s/:sellerId
/// URL — and `deletedAt`, which grants and revokes the role.
model SellerProfile {
  /// A UUID, and the client may choose it (iOS Plan 17 A).
  ///
  /// The iPad creates sellers offline, so it has to name a row before the
  /// server can. It used to name one with its own id, get a cuid back, and
  /// rewrite the id everywhere it had been used — the row, its items, its
  /// photos, every queued payload, and an alias table for screens still
  /// holding the old one. Three field bugs came out of that machinery. One id,
  /// minted by whoever creates the row, removes all of it.
  ///
  /// Also what makes printed paper right: a receipt QR encodes `/s/<id>`, and
  /// before this it encoded an id that would never resolve.
  id           String @id @default(uuid())
  membershipId String @unique

  /// Set ⇒ this membership sells on behalf of a business; null ⇒ individual.
  /// Replaces the old `type` enum, so the two can no longer contradict.
  businessName String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  membership       Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  swapItems        SwapItem[]
  assignedPrinters SwapPrinter[]
  receipts         Receipt[]
  payoutLines      PayoutLine[]
}

model SwapItem {
  /// A UUID, and the client may choose it (iOS Plan 17 A). See
  /// `SellerProfile.id` — same reason, same rule.
  id               String  @id @default(uuid())
  swapId           String
  orgId            String
  sellerId         String?
  name             String
  description      String? @db.Text
  /// Null only for a legacy ticket whose price comes after check-in (Plan 32).
  /// Square then sells it at a price the clerk types.
  priceCents       Int?
  sku              String
  /// Mirror of `sku`, written only while the item is live.
  ///
  /// MySQL allows many NULLs in a unique index, so tombstones never collide —
  /// which is what lets a deleted item's ticket go back in the pile. The same
  /// trick `SkiSwap.activeSkuPrefix` uses, for the same reason: MySQL has no
  /// partial unique index to say `WHERE deletedAt IS NULL` with.
  ///
  /// `sku` itself is never cleared. It is what the tag in somebody's hand says,
  /// and a receipt or a payout line that names it has to keep meaning something.
  liveSku          String?
  originalQuantity Int

  // Square sync state — null when Square is not configured
  squareItemId      String?
  squareVariationId String?
  lastSyncedAt      DateTime?
  donateProceeds    Boolean   @default(false)
  hasPrintedTag     Boolean   @default(false)

  /// When a staff member accepted this item onto the floor.
  ///
  /// Null means it is waiting to be seen: the seller has tagged it and is
  /// standing beside it. An item is pushed to Square when this is set and never
  /// before, so null is also the answer to "can this be sold".
  ///
  /// Set at creation for everything except a self check-in at an org that has
  /// `requireConsignmentScan` on — the setting is read once, there, and never
  /// again. That is what lets the toggle change mid-swap without moving
  /// anything already on the floor.
  consignedAt DateTime?
  /// Whoever accepted it: a user id, or a device id when the staff iPad did.
  /// The audit log carries which of the two, so this does not need to.
  consignedBy String?

  /// Handed back to its seller, unsold (Plan 43). A state of a live item, not
  /// a delete: it stays on the seller's record and on the iPads. A returned
  /// item is out of Square, so it can't ring up after it has gone home.
  returnedAt    DateTime?
  /// Whoever handed it back: a user id, or a device id when an iPad did.
  returnedBy    String?   @db.VarChar(191)
  /// Their name as it was then, for "Already returned by Pat" without a lookup.
  returnedByName String?  @db.VarChar(191)
  /// How many went back: the quantity less any sold. 1 for nearly every item.
  returnedUnits Int?

  /// The CATEGORY node this item was described under. Null for an item created
  /// by an importer that only had a name (Plan 19 D12).
  categoryId String?

  /// Soft delete. The row stays so a delta can carry the removal to an iPad
  /// that holds a copy — absence is not something `updatedSince` can express,
  /// and a cache cannot be told about a row that is not there.
  ///
  /// Returned **only** to a caller passing `updatedSince`, exactly as sellers
  /// are: a plain list is a screen, and a deleted item has no business on one.
  /// Every other read filters it out, which the coverage test enforces.
  deletedAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  swap       SkiSwap             @relation(fields: [swapId], references: [id], onDelete: Cascade)
  org        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  seller     SellerProfile?      @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  photos     SwapItemPhoto[]
  category   TaxonomyNode?       @relation("ItemCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  attributes SwapItemAttribute[]

  @@unique([swapId, liveSku])
  /// The unique index used to serve these lookups too. It now covers only live
  /// items, so scanning a tag needs its own.
  @@index([swapId, sku])
  @@index([orgId, sku])
  @@index([orgId])
  @@index([sellerId])
  @@index([swapId, consignedAt])
  @@index([swapId, returnedAt])
  @@index([orgId, categoryId])
}

model SwapItemPhoto {
  id            String   @id @default(cuid())
  itemId        String
  s3Key         String   @default("") // empty when S3 not configured
  url           String
  squareImageId String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  item SwapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model SwapPrinter {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  bluetoothName    String
  /// Which printer this is. Decides the head width and where narrower stock
  /// sits under it — see printing/geometry.ts. "m110" | "m221"
  model            String   @default("m110")
  paperSize        String   @default("50x30") // "50x30" | "62x100"
  /// Safety inset in dots. Labels do not always sit square in the printer, and
  /// anything drawn to the exact edge is the first thing lost. Defaults come
  /// from the label size, not from here — these are only the overrides.
  marginTop        Int      @default(4)
  marginBottom     Int      @default(4)
  marginLeft       Int      @default(0)
  marginRight      Int      @default(28)
  /// Set ⇒ this printer belongs to one business seller, and cannot also be
  /// driven by a bridge. A printer serves exactly one thing.
  assignedSellerId String?
  /// The bridge that drives this printer. Unique: a printer is a single BLE
  /// peripheral and whoever holds the link owns it, so two bridges pointed at
  /// one would fight over it. A station reaches its printer through its bridge.
  bridgeDeviceId   String?  @unique
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  seller SellerProfile? @relation(fields: [assignedSellerId], references: [id], onDelete: SetNull)
  bridge Device?        @relation("BridgedPrinter", fields: [bridgeDeviceId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([assignedSellerId])
}

/// A barcode scanner a bridge drives, for reading tags off gear at a counter.
///
/// Deliberately its own table rather than a row in `SwapPrinter` with a kind:
/// everything that makes a printer a printer — paper size, four margins, the
/// business seller who holds it — means nothing here, and a scanner is never
/// handed to a seller. What the two share is a name, a BLE name, and a bridge,
/// which is three columns rather than a shared abstraction.
model SwapScanner {
  id            String @id @default(cuid())
  orgId         String
  name          String
  /// The advertised BLE name, exactly as the scanner gives it — `BCST-23-XXXX`
  /// for the Inateck, with nothing added. It is what the bridge is told to
  /// connect to, so it has to match the air verbatim.
  bluetoothName String

  /// The bridge that drives this scanner. Unique for the same reason a
  /// printer's is: a scanner is a single BLE peripheral, whoever holds the link
  /// owns it, and two bridges pointed at one would fight over it.
  bridgeDeviceId String? @unique

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bridge Device?      @relation("BridgedScanner", fields: [bridgeDeviceId], references: [id], onDelete: SetNull)

  @@index([orgId])
}

/// A place a seller checks themselves in: a QR code and a printer, with a bridge
/// between. The station is the layer that survives replacing either piece of
/// hardware beneath it, which is why it owns the SKU namespace character.
model CheckinStation {
  id    String @id @default(cuid())
  orgId String
  /// Human label — "Station 3".
  name  String
  /// One character. The SKU namespace for everything checked in here, staffed
  /// or self-service, and however the tag was printed. The only consumer of
  /// the pool. A retired station keeps its letter as history; the letter is
  /// free again once no running swap has SKUs under it.
  code  String @db.VarChar(1)
  /// `code` while the station is live, null once retired: the same trick
  /// `SkiSwap.activeSkuPrefix` uses, since MySQL has no partial unique index.
  /// It's what stops two live stations sharing a letter.
  liveCode String? @db.VarChar(1)

  /// The staff tablet stationed at this counter. Its presence is what makes the
  /// station staffed rather than self-service — a stored `kind` could contradict
  /// the hardware attached to it, so the kind is derived instead.
  attendantDeviceId String?   @unique
  /// The bridge that prints for this station. Re-bindable: hardware dies
  /// mid-swap, and queued jobs survive because they belong to the station, not
  /// the bridge. Required for self-service, where a seller has no other way to
  /// get a tag; optional for staffed, where the tablet can print over Bluetooth.
  ///
  /// Not unique (Plan 27): several staffed stations may share one bridge and
  /// its printer. A self-service station keeps its bridge to itself.
  bridgeDeviceId    String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendant Device?      @relation("StationAttendant", fields: [attendantDeviceId], references: [id], onDelete: SetNull)
  bridge    Device?      @relation("StationBridge", fields: [bridgeDeviceId], references: [id], onDelete: SetNull)
  printJobs PrintJob[]

  @@unique([orgId, liveCode])
  @@index([orgId, deletedAt])
  @@index([bridgeDeviceId])
}

/// A label waiting to print. Holds a recipe rather than bytes: the raster is
/// rendered when the job is claimed, so a job adapts to whichever printer is
/// actually attached at that moment.
model PrintJob {
  id        String  @id @default(cuid())
  orgId     String
  /// Where the job goes.
  stationId String
  /// Which printer it was queued against. Diagnostics only — the render
  /// resolves the station's current printer at claim time.
  printerId String?

  /// Set when a job belongs to a check-in; null for staff-initiated work.
  swapId   String?
  sellerId String?
  /// The item this tag depicts. Null for receipts and calibration. What lets an
  /// ack flip SwapItem.hasPrintedTag once every tag for that item has printed.
  itemId   String?

  /// item | receipt_header | receipt_items | qr | calibration
  kind   String
  /// Anything the recipe needs beyond the ids above — the page index of a
  /// paginated receipt, the text of a QR label.
  params Json?
  /// Ordering within one seller's batch, so tags emerge in entry order.
  seq    Int    @default(0)

  /// queued | claimed | printed | failed | abandoned
  status     String    @default("queued")
  claimToken String?
  claimedAt  DateTime?
  /// Claim expiry. A job past this with status=claimed returns to the queue.
  claimUntil DateTime?
  printedAt  DateTime?
  /// Dropped, not printed, if no bridge has taken it by then. Helper labels
  /// only (Plan 28): they are wanted while the ticket is in the volunteer's
  /// hand, and a pair printed an hour late is for a ticket long gone. Null for
  /// every other kind, which waits however long it takes.
  notAfter   DateTime?
  /// A page the iPad drew itself (iOS Plan 26), printed as sent. Null for every
  /// job the server renders, and cleared once the job is settled.
  raster     Bytes?    @db.MediumBlob
  attempts   Int       @default(0)
  lastError  String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  station CheckinStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, status, seq])
  @@index([status, claimUntil])
  @@index([itemId, status])
  @@index([orgId, createdAt])
}

/// One SKU counter per minting endpoint per swap, so stations never contend.
/// `code` is a station code or a check-in device code — one shared per-org pool.
model SwapSkuCounter {
  id          String @id @default(cuid())
  swapId      String
  code        String @db.VarChar(1)
  lastCounter Int    @default(0)

  swap SkiSwap @relation(fields: [swapId], references: [id], onDelete: Cascade)

  @@unique([swapId, code])
}

model SkiSwapSettings {
  id            String @id @default(cuid())
  orgId         String @unique

  /// Whether a self check-in item waits for a staff member to scan it before
  /// it can be sold. Off by default: an org that has not asked for the extra
  /// step should not get it.
  ///
  /// Read once, when an item is created, and stored on the row. Changing it
  /// decides what happens to items checked in from now on and never revisits
  /// what is already on the floor.
  requireConsignmentScan Boolean @default(false)

  /// The org's cut, in hundredths of a percent. 2000 is 20%.
  ///
  /// An integer because a percent invites 20.5 and then a float, and float
  /// arithmetic has no place in money. Nobody sees this number: it is set and
  /// displayed as a percentage, converted only at the edges (Plan 25 §3).
  commissionBasisPoints Int @default(0)

  /// The PIN that unlocks the admin sheet on a `ski_swap.staff_check_in` iPad.
  ///
  /// Four digits, and stored in the clear on purpose: this gates a settings
  /// screen against someone standing at the table, not a credential, and the
  /// question an administrator actually asks is what the PIN *is*. Hashing it
  /// would cost that lookup and buy nothing — four digits fall to a loop.
  ///
  /// Null means no gate: the sheet opens straight through. That is also the
  /// answer a device that has never synced arrives at, which is deliberate —
  /// locking it out would brick the one screen that can diagnose a bad sync.
  devicePin String? @db.VarChar(4)

  /// Bumped whenever any taxonomy node visible to this org changes — its own,
  /// or a global one. The clients' cache key for the resolved tree. A counter
  /// rather than a timestamp because the phone compares it for equality, not
  /// for order.
  taxonomyVersion Int @default(1)

  /// Barcodes on a tall (62 × 100) item tag: 1, across the foot; or 2, one
  /// across the head and one across the foot, price and name between, so the
  /// tag scans from either end. The small tag always has one.
  barcodesPerTicket Int @default(1)

  /// A ski boot marked Mens, Womens or Kids is named with its US size beside
  /// its Mondopoint: "Ski boots MP 26.5 (US M 8.5)". Off: "Ski boots MP 26.5".
  /// Read when the name is composed, so it changes new names, not old ones.
  showUsBootSizes Boolean @default(false)

  /// The patrol has declared itself a retail member of the National Ski &
  /// Snowboard Retailers Association (Plan 44 D5). NSSRA publishes its
  /// combined indemnified-bindings list for members only, so entries sourced
  /// from it are shown to this org only while this is on. Who turned it on,
  /// and when, is kept: it is a declaration, and a declaration has an author.
  nssraMember      Boolean   @default(false)
  nssraMemberSetBy String?   @db.VarChar(191)
  nssraMemberSetAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─── Item description tree (Plan 19) ─────────────────────────────────────────

enum TaxonomyKind {
  CATEGORY
  ATTRIBUTE
  VALUE
}

enum TaxonomyInput {
  /// Pick one of the child VALUE nodes. The only kind that branches.
  SELECT
  /// Type a number, rendered with `unit`. A leaf, always (D9).
  NUMBER
}

enum TaxonomyStatus {
  /// Offered to everyone in scope.
  APPROVED
  /// Minted by free entry. Usable by the item that created it, and visible in
  /// the org's queue. Not offered to anyone else until approved (D7).
  PENDING
}

/// One node of the item-description tree: a category, a question, or an answer.
///
/// Global rows (`orgId = null`) are curated by platform admins and visible to
/// every org. Org rows are that org's own, and may hang off a global parent —
/// that is how an org adds a brand to the shared Manufacturer list without
/// forking it (D2).
model TaxonomyNode {
  id       String       @id @default(cuid())
  kind     TaxonomyKind
  /// Null ⇒ global. Set ⇒ belongs to one org.
  orgId    String?
  /// Null only for a CATEGORY.
  parentId String?

  /// What the seller reads. Also what lands in the derived name, so it is
  /// written the way it should print: "Helly Hansen", not "helly-hansen".
  label String @db.VarChar(120)

  // ── Icon: at most one of the two (D11) ────────────────────────────────────
  /// A key into the web app's icon registry. Never a Font Awesome name, and
  /// validated against the registry on write so a typo is refused at the admin
  /// screen rather than discovered as a blank chip.
  iconKey String? @db.VarChar(40)

  /// A 128×128 PNG for a node the registry does not cover.
  ///
  /// `iconUrl` is the only one of the three clients read, and it is always a
  /// URL — never a data URI. One of the other two holds the bytes: `iconS3Key`
  /// when S3 is configured, keyed by node id so promotion needs no copy;
  /// `iconBlob` otherwise, read only by the proxy route.
  iconUrl   String? @db.Text
  iconS3Key String? @db.VarChar(300)
  iconBlob  Bytes?  @db.MediumBlob

  status       TaxonomyStatus @default(APPROVED)
  displayOrder Int            @default(0)
  /// Hides a node from new picks without deleting it. A node any item points
  /// at may never be hard-deleted, and this is how it leaves the tree
  /// instead (D4).
  retiredAt    DateTime?

  // ── ATTRIBUTE only ────────────────────────────────────────────────────────
  input          TaxonomyInput?
  /// Where this answer sits in the derived name, ascending. Null ⇒ captured
  /// but not named — a detail worth having in a report and not on a tag.
  nameSlot       Int?
  /// Appended to a NUMBER with no space: 112 + "cm" ⇒ "112cm".
  unit           String?        @db.VarChar(12)
  minValue       Float?
  maxValue       Float?
  step           Float?
  /// Whether a seller may type a value that is not listed, minting a PENDING
  /// org value (D7). SELECT only.
  allowFreeEntry Boolean        @default(false)

  // ── Dedupe ────────────────────────────────────────────────────────────────
  /// `<orgId|global>:<parentId|root>:<label lower-cased, trimmed, spaces
  /// collapsed>`. One non-null column rather than a composite unique, because
  /// both `orgId` and `parentId` are nullable and MySQL would let two global
  /// categories with the same label through. Maintained in the service, never
  /// by the client.
  dedupeKey String @unique @db.VarChar(400)

  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Who approved a PENDING value, and when. Null while pending.
  approvedBy  String?
  approvedAt  DateTime?
  /// Set when an org asks for this value to become global. Null otherwise.
  suggestedAt DateTime?

  // ── VALUE only (Plan 44 D14) ──────────────────────────────────────────────
  /// "My details are that value's details." Set on a VALUE that has no
  /// questions of its own: resolving it inlines the target's attributes, and
  /// an item answering them stores the shared attribute and value ids. How
  /// Skis › Bindings included › Yes asks the binding questions without a
  /// second copy of every binding model. Global values only, pointing at
  /// global values only; never a cycle.
  sameDetailsAsId String?

  org      Organization?  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   TaxonomyNode?  @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TaxonomyNode[] @relation("TaxonomyTree")

  sameDetailsAs  TaxonomyNode?  @relation("TaxonomySameDetails", fields: [sameDetailsAsId], references: [id], onDelete: SetNull)
  sameDetailsFor TaxonomyNode[] @relation("TaxonomySameDetails")

  itemCategories    SwapItem[]          @relation("ItemCategory")
  itemAttributeUses SwapItemAttribute[] @relation("AttributeNode")
  itemValueUses     SwapItemAttribute[] @relation("ValueNode")
  /// The seasons this binding model was on an indemnified list (Plan 44).
  indemnifications  BindingIndemnification[]

  @@index([orgId, kind])
  @@index([parentId, displayOrder])
  /// The org approval queue, which is the only query that wants status alone.
  @@index([orgId, status])
  @@index([sameDetailsAsId])
}

/// One answered question on one item. Pointers only (D3); labels are read back
/// through the tree, which D4 guarantees is still there.
model SwapItemAttribute {
  id     String @id @default(cuid())
  itemId String

  /// The ATTRIBUTE node that was asked.
  attributeId String
  /// The VALUE node that was picked. Null for a NUMBER answer, which has no
  /// node to point at — the answer is the number.
  valueId     String?
  /// The NUMBER answer, unrendered. Its unit comes from the attribute, so a
  /// report compares 112 to 115 rather than parsing "112cm".
  numberValue Float?

  createdAt DateTime @default(now())

  item      SwapItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Restrict, deliberately: this is where D4 is enforced.
  attribute TaxonomyNode  @relation("AttributeNode", fields: [attributeId], references: [id], onDelete: Restrict)
  value     TaxonomyNode? @relation("ValueNode", fields: [valueId], references: [id], onDelete: Restrict)

  /// One answer per question per item.
  @@unique([itemId, attributeId])
  @@index([valueId])
  @@index([attributeId])
}

// ─── Time Clock ───────────────────────────────────────────────────────────────

model Resort {
  id        String    @id @default(cuid())
  orgId     String
  name      String
  street    String?
  city      String?
  state     String?
  zip       String?
  /// IANA zone derived from the address; shift arithmetic depends on it.
  timeZone  String    @default("America/New_York")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shifts  TimeClockShift[]
  events  TimeClockEvent[]
  /// The terminals standing at this resort. Several is normal.
  devices Device[]

  @@index([orgId, deletedAt])
  @@index([orgId, updatedAt])
}

/// The patroller role, granted on a membership. Deliberately thin: nspId,
/// patrolLevel and the person's name live on User. `active` is genuinely
/// org-scoped — on the roster at this mountain, but not currently patrolling.
model PatrollerProfile {
  id           String @id @default(cuid())
  membershipId String @unique

  active Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  membership Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  shifts     TimeClockShift[]
  events     TimeClockEvent[]
}

model TimeClockEvent {
  id          String   @id
  orgId       String
  resortId    String
  patrollerId String
  deviceId    String?
  type        String
  dutyType    String?
  dutyNote    String?  @db.VarChar(120)
  source      String   @default("device")
  occurredAt  DateTime
  recordedAt  DateTime @default(now())
  clockSkewMs Int?
  status      String   @default("applied")
  statusNote  String?

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resort    Resort           @relation(fields: [resortId], references: [id])
  patroller PatrollerProfile @relation(fields: [patrollerId], references: [id])

  @@index([orgId, patrollerId, occurredAt])
  @@index([orgId, status])
  @@index([resortId])
}

model TimeClockShift {
  id             String    @id
  orgId          String
  resortId       String
  patrollerId    String
  dutyType       String
  dutyNote       String?   @db.VarChar(120)
  clockInAt      DateTime
  clockOutAt     DateTime?
  status         String
  closeReason    String?
  flagged        Boolean   @default(false)
  editedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resort    Resort           @relation(fields: [resortId], references: [id])
  patroller PatrollerProfile @relation(fields: [patrollerId], references: [id])

  @@index([orgId, resortId, status])
  @@index([orgId, updatedAt])
  @@index([orgId, patrollerId, status])
  @@index([resortId])
  @@index([patrollerId])
}

model TimeClockSettings {
  id                  String @id @default(cuid())
  orgId               String @unique
  autoCloseLocalTime  String @default("03:00")
  autoCloseAfterHours Int    @default(4)

  /// The PIN that unlocks the settings sheet on a `time_clock.terminal`.
  ///
  /// Same shape and same rules as `SkiSwapSettings.devicePin`; a separate
  /// column because they are separate answers — the swap tables and the patrol
  /// room are different rooms with different people standing in them.
  devicePin String? @db.VarChar(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─── Device bootstrap ─────────────────────────────────────────────────────────

/// An apt repository a device may install from.
///
/// Platform-scoped, deliberately: there is no `orgId` because the fleet installs
/// PatrolKit's software from PatrolKit's repository. An org that could name its
/// own repository could install its own software on hardware we support.
model BootstrapRepository {
  id String @id @default(cuid())

  /// The apt source name. Constrained to `[a-z0-9][a-z0-9-]*` by the device's
  /// own schema, so it is validated on the way in rather than discovered on the
  /// way out.
  name       String @unique @db.VarChar(64)
  uri        String @db.VarChar(512)
  suite      String @db.VarChar(64)
  /// Comma-separated on the way in, rendered as a JSON array on the way out.
  /// One row per component would be a table to hold the word "main".
  components String @db.VarChar(255)
  arch       String @default("arm64") @db.VarChar(16)

  /// The signing key fingerprint the device must already carry.
  ///
  /// The server cannot validate this and must not pretend to: every key a
  /// device will ever honour is baked into its image at build time, and a
  /// manifest naming any other is rejected outright — silently, on the device,
  /// with no error path back here. A typo takes out every device of every role
  /// that names this repository.
  signedByKeyId String @db.VarChar(64)
  /// apt pin priority, when a repository must win or lose against another.
  pinPriority   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles BootstrapProfile[]
}

/// What one device role runs. One row per role, platform-wide.
///
/// This is the record that makes the device image generic in fact rather than
/// in principle — it is where "this device is a signage device, here is the
/// package and version to run" is expressed, instead of being baked into an
/// image at build time.
model BootstrapProfile {
  id String @id @default(cuid())

  /// The `Device.role` this serves, e.g. `signage.display`.
  role       String @unique @db.VarChar(100)
  /// Informational, passed through as `manifest.deviceType`. The image never
  /// branches on it.
  deviceType String @db.VarChar(64)

  /// Off serves a 404, which a device answers by keeping the manifest it has.
  /// Deleting the profile would do the same thing and lose the configuration.
  enabled Boolean @default(true)

  updateEnabled      Boolean @default(true)
  /// `HH:MM-HH:MM` local to the device, or null to leave the image's own
  /// configured window in force.
  updateWindow       String? @db.VarChar(16)
  checkinIntervalSec Int     @default(3600)

  /// Counts edits, not resolutions.
  ///
  /// A package that tracks latest changes what is served with no edit behind
  /// it, so this cannot be the cache key — the ETag over the resolved manifest
  /// is. Devices diff package versions and never read this, so the two moving
  /// independently costs nothing.
  manifestVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Rendered in name order, so editing an unrelated repository cannot churn
  /// the ETag and wake up a fleet.
  repositories BootstrapRepository[]
  packages     BootstrapPackage[]
}

/// One package a role installs, pinned or tracking.
model BootstrapPackage {
  id        String @id @default(cuid())
  profileId String

  name    String  @db.VarChar(128)
  /// The pinned version, or null to track the newest in the repository.
  ///
  /// The device diffs version strings and treats any difference as work to do,
  /// in either direction — a manifest that pins backwards is a deliberate
  /// rollback and is honoured as one.
  version String? @db.VarChar(64)

  /// What tracking last resolved to, and when.
  ///
  /// Durable rather than merely cached: it is what gets served when the apt
  /// index is unreachable. Without it, a repository having a bad five minutes
  /// would stop every device of this role checking in.
  resolvedVersion String?   @db.VarChar(64)
  resolvedAt      DateTime?

  /// Render order. Cosmetic to the device, which installs the set, but it keeps
  /// the manifest bytes — and therefore the ETag — stable across edits.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile BootstrapProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

/// Which published device image end users are offered.
///
/// One row, platform-wide. The bucket accumulates every image ever published,
/// because an older one is occasionally the one somebody needs — but a customer
/// choosing from a list of four is a customer picking wrong, so exactly one is
/// promoted and that is the only one they ever see.
///
/// Promotion is deliberately separate from publishing: an image can be built,
/// published, and flashed onto a bench card before anybody else is offered it.
/// Nothing here validates that the named image exists; the catalogue lives in
/// S3 and is the authority, so a promotion naming a deleted image resolves to
/// nothing being offered rather than to a broken download.
model DeviceImageRelease {
  id String @id @default(cuid())

  /// The image config's name, e.g. `patrolkit-device`.
  name    String @db.VarChar(64)
  version String @db.VarChar(64)

  /// Who promoted it, for the same reason installs are journalled: this
  /// decides what every new device in the field gets flashed with.
  promotedBy String?  @db.VarChar(64)
  promotedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
}

/// One check-in, frozen (Plan 24 §3).
///
/// A receipt is a record of a transaction — *this is what you handed over, this
/// is what it was priced at* — so it cannot follow the edits that happen
/// afterwards. The live view of a seller's items already exists at
/// `/s/:sellerId` and answers a different question.
model Receipt {
  id        String  @id
  orgId     String
  swapId    String
  sellerId  String
  /// Where it happened. Null for a receipt minted from the sellers list.
  stationId String?

  /// The public link. Random, not derived from any id: a leaked link should
  /// expose one check-in and nothing else.
  token     String    @unique @db.VarChar(32)
  /// Revokes the link without deleting the record.
  revokedAt DateTime?

  /// Denormalised so the public page renders without joining a live tree, and
  /// so an org rename does not rewrite history.
  orgName     String
  /// A copy of `Organization.logoUrl`, and the same type as it.
  ///
  /// Not `VARCHAR(191)`. That column was widened to MediumText so an org
  /// without S3 could keep its mark as a data URI, and this copy was left
  /// behind — so every receipt for such an org failed to snapshot on
  /// "value too long for orgLogoUrl". Silently, because snapshotting is
  /// best-effort, which meant those orgs simply had no receipts and nothing
  /// said why.
  orgLogoUrl  String? @db.MediumText
  swapTitle   String
  sellerName  String
  /// Where the money was going, as it was then.
  payoutLabel String?

  totalCents Int
  itemCount  Int

  createdAt DateTime @default(now())

  org    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  swap   SkiSwap       @relation(fields: [swapId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  lines      ReceiptLine[]
  deliveries ReceiptDelivery[]

  @@index([orgId, swapId, sellerId, createdAt])
}

/// A line as it was.
///
/// `itemId` is a pointer for staff tooling; the text is the record and is never
/// re-resolved — Plan 19's frozen-name rule, applied to the receipt rather than
/// the item. Deliberately no foreign key: deleting an item must not reach in
/// here and rewrite what somebody was handed.
model ReceiptLine {
  id         String  @id
  receiptId  String
  itemId     String?
  name       String
  sku        String
  /// The item's price when the receipt was made; null while it had none.
  priceCents Int?
  position   Int

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId, position])
}

/// One attempt to put a receipt in somebody's hands (Plan 24 §9).
///
/// `status` is `SendOutcome` written down. SUPPRESSED is the one that earns its
/// place: OUTBOUND_NOTIFICATIONS is off outside production, and without it a
/// staging box stores a delivery that never happened.
model ReceiptDelivery {
  id          String   @id
  receiptId   String
  /// EMAIL | SMS
  channel     String   @db.VarChar(8)
  /// The address or number it actually went to, as it was then.
  destination String
  /// SENT | SUPPRESSED | FAILED
  status      String   @db.VarChar(12)
  /// The provider's id for the message, when there is one.
  providerRef String?
  error       String?  @db.Text
  /// Who pressed the button. Null when the seller sent it to themselves.
  actorUserId String?
  createdAt   DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId, createdAt])
  /// Receipts per destination (Plan 26 §6).
  @@index([destination, createdAt])
  /// Texts per hour, site-wide (Plan 26 §7).
  @@index([channel, createdAt])
}

/// A PayPal account that can send payouts, one per org (Plan 25 §6).
///
/// Shaped like `SquareConfig` deliberately — same encryption, same
/// never-read-back secret, same audit row on every write.
model PayPalConfig {
  id             String @id
  orgId          String @unique
  clientId       String @db.Text
  /// AES-256-GCM JSON: { iv, tag, ct }. Never returned by any endpoint.
  clientSecretEnc String @db.Text
  /// "sandbox" | "live"
  environment    String @default("sandbox") @db.VarChar(8)
  /// The webhook id registered with PayPal, needed to verify a delivery.
  webhookId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// One swap's payout run (Plan 25 §4).
///
/// A swap has at most one open run; closing it is what makes the amounts final.
model PayoutRun {
  id       String @id
  orgId    String
  swapId   String
  /// DRAFT | REVIEW | CLOSED
  status   String @db.VarChar(12)

  /// The window the orders were read from, so a re-read is reproducible and a
  /// sale after the run is visibly after it.
  salesFrom DateTime
  salesTo   DateTime

  /// Copied from settings when the run opens. Changing the setting later must
  /// not restate what a seller has already been told they would get.
  commissionBasisPoints Int

  /// Bumped every time a send is attempted. Half of `sender_batch_id`, which is
  /// what stops PayPal paying a batch twice (§7).
  sendAttempt Int @default(0)

  /// Sales in the window that matched no item of this swap — something rung up
  /// by hand, a mis-scan, or another swap's stock at the same location (§12).
  ///
  /// Kept rather than only logged: this is money the org took that nobody is
  /// being paid for, and a log line nobody reads is the same as dropping it.
  /// Frozen with the run, because it is a statement about one reading of the
  /// orders and re-deriving it would need Square again.
  unmatchedSales Json?

  createdAt DateTime  @default(now())
  closedAt  DateTime?
  closedBy  String?

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  swap  SkiSwap      @relation(fields: [swapId], references: [id], onDelete: Cascade)
  lines PayoutLine[]

  @@index([orgId, createdAt])
  @@index([swapId, status])
}

/// What one seller is owed in one run, and what happened to it.
model PayoutLine {
  id       String @id
  runId    String
  sellerId String

  /// Frozen when the run was built, like a receipt's lines.
  sellerName  String
  /// PAYPAL | VENMO | CHECK | DONATE
  method      String  @db.VarChar(8)
  /// Resolved at build time, so a seller who changes their email mid-run
  /// cannot redirect a payment somebody has already approved.
  destination String?
  /// The PayPal `recipient_type`: EMAIL | PHONE | PAYPAL_ID | USER_HANDLE.
  destinationType String? @db.VarChar(12)

  grossCents      Int
  commissionCents Int
  netCents        Int

  /// PENDING | APPROVED | SENDING | SENT | UNCLAIMED | FAILED | RETURNED |
  /// PAID_BY_CHECK | DONATED
  status     String  @db.VarChar(16)
  /// Why it is where it is: PayPal's failure reason, or that a held item is
  /// under review.
  statusNote String? @db.Text

  /// PayPal's own ids, for reconciling against their dashboard.
  payoutBatchId String?
  payoutItemId  String?

  /// Set when a person approved this line. Nothing sends without it.
  approvedBy String?
  approvedAt DateTime?
  sentAt     DateTime?

  /// Check tracking (§10). Null for every other method.
  checkNumber String?
  checkSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run    PayoutRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id])
  items  PayoutLineItem[]
  notices PayoutNotice[]

  @@unique([runId, sellerId])
  @@index([runId, status])
  @@index([payoutBatchId])
}

/// The evidence. One row per item sold, as it was.
model PayoutLineItem {
  id     String  @id
  lineId String
  /// A pointer for staff tooling. The text beside it is the record, and no
  /// foreign key, because deleting an item must not rewrite what somebody was
  /// paid on.
  itemId String?

  name       String
  sku        String
  /// What the seller was owed on: `SwapItem.priceCents` at run time, or, for
  /// a ticket sold before it was priced, what the clerk typed (Plan 32).
  priceCents Int
  quantity   Int
  /// What Square actually took, which may be less. Recorded so the org can see
  /// what a discount cost it; never what the seller is paid on.
  collectedCents Int
  /// The order this came from, and when. What makes the payout defensible.
  squareOrderId String
  soldAt        DateTime
  refundedQty   Int @default(0)

  line PayoutLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
}

/// A nudge sent to a seller about an unclaimed payout (§9).
///
/// Recorded like `ReceiptDelivery`: a suppressed nudge is not a sent one, and a
/// row per attempt is what stops day 7 being sent twice.
model PayoutNotice {
  id     String @id
  lineId String
  /// Which nudge this was: 7 or 21 days after the payout went unclaimed.
  dayMark Int
  /// EMAIL | SMS
  channel     String @db.VarChar(8)
  destination String
  /// SENT | SUPPRESSED | FAILED
  status      String  @db.VarChar(12)
  error       String? @db.Text

  createdAt DateTime @default(now())

  line PayoutLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, dayMark])
  @@index([lineId])
}

/// How close traffic came to each limit, by the hour (Plan 26 §11).
///
/// Counts, never keys: no IP address, user, device, phone number or email is
/// written here — only how far the busiest of them got.
model LimitUsage {
  /// An id from the registry in `common/limits/limits.ts`.
  limitId      String   @db.VarChar(64)
  hourStart    DateTime
  /// `''` for platform-wide, never NULL. This is the primary key, and a key
  /// that allowed NULL would let two flushes of the same hour land as two rows.
  orgId        String   @default("") @db.VarChar(64)
  swapId       String   @default("") @db.VarChar(64)
  /// The most any single key reached within one window of the limit.
  peakHits     Int
  /// The limit in force when that peak was reached. Limits change; a peak means
  /// something only against the number it was measured against.
  limitValue   Int
  /// How many keys crossed half.
  nearCount    Int      @default(0)
  /// How many requests were refused.
  refusedCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([limitId, hourStart, orgId, swapId])
  @@index([hourStart])
}

/// One telemetry report from a device, as it was sent (webprinter_esp32 Plan 4).
///
/// `body` is the report verbatim, fields we do not know included: telemetry
/// gains fields more often than anything else the firmware sends, and a server
/// that refused unknown ones is how a bridge was once taken offline. The
/// columns beside it are copied out of the body for querying, and are null
/// wherever the body left a value out or sent it with the wrong type.
model DeviceTelemetry {
  id               String   @id @default(cuid())
  deviceId         String
  /// Our clock. The device only counts from boot.
  receivedAt       DateTime @default(now())
  body             Json
  /// Known fields that arrived with the wrong type, by path. Kept as sent in
  /// `body`; left out of the columns.
  malformedFields  Json?

  v                Int?
  firmwareVersion  String?  @db.VarChar(64)
  board            String?  @db.VarChar(64)
  bootCount        Int?
  resetReason      String?  @db.VarChar(32)
  uptimeMs         BigInt?
  /// `receivedAt - uptimeMs`: when this boot happened, by our clock.
  bootAt           DateTime?
  /// Boots since this device's previous report — usually 0; 1 on the first
  /// report after a reboot; more when reports were missed during a crash loop.
  bootsSincePrevious Int    @default(0)
  /// A new boot whose reason was a crash or a power fault. See `UNPLANNED_RESETS`.
  unplannedReboot  Boolean  @default(false)
  memFree          Int?
  memLargestBlock  Int?
  memMinFreeEver   Int?
  psram            Boolean?
  wifiRssi         Int?
  printerLink      String?  @db.VarChar(16)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, receivedAt])
  @@index([receivedAt])
}

/// A stretch when a bridge stopped checking in, measured from its claims.
///
/// A bridge claims every one to eleven seconds, so a gap longer than the
/// twenty-second offline rule is an outage. Recorded when the bridge comes
/// back; one still going is read from `Device.lastSeenAt` instead.
model DeviceOutage {
  id        String   @id @default(cuid())
  deviceId  String
  /// When the bridge was last seen before the gap.
  startedAt DateTime
  /// When it checked in again.
  endedAt   DateTime

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, startedAt])
  @@index([endedAt])
}

/// Platform-wide settings (Plan 29). Exactly one row, id 1, inserted by its
/// migration; changed from Platform Admin → Configuration without a deploy.
model PlatformSettings {
  id          Int      @id @default(1)
  /// Texting: sign-in codes, phone verification, texted receipts and payout
  /// reminders. Off until a toll-free originator is approved; while off, every
  /// SMS feature is hidden and refused.
  smsEnabled  Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ─── Swap diagnostics (Plan 41) ──────────────────────────────────────────────

/// One run of the swap diagnostics: our items against the swap's Square
/// category, matched by SKU. The last 30 per swap are kept.
model SwapDiagnosticRun {
  id          String    @id @default(cuid())
  orgId       String
  swapId      String
  startedBy   String?
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?
  /// "running" | "done" | "failed"
  status      String    @db.VarChar(16)
  /// Square items read so far, for the progress line.
  done        Int       @default(0)
  error       String?   @db.Text
  /// Live items of ours, and items in the Square category, when it finished.
  ourCount    Int?
  squareCount Int?

  swap   SkiSwap               @relation(fields: [swapId], references: [id], onDelete: Cascade)
  issues SwapDiagnosticIssue[]

  @@index([swapId, startedAt])
}

/// One disagreement a run found, and what staff chose to do about it.
model SwapDiagnosticIssue {
  id          String    @id @default(cuid())
  runId       String
  swapId      String
  sku         String
  /// "only_square" | "only_ours" | "differs" | "not_linked" | "twice"
  kind        String    @db.VarChar(16)
  /// For "differs": "name" | "notes" | "price".
  field       String?   @db.VarChar(8)
  /// What was compared, with ids: our item, and Square's item or copies.
  ours        Json?
  square      Json?
  /// Both sides' compared values, hashed: what "left as is" hides.
  fingerprint String    @db.VarChar(64)
  /// "open" | "applied" | "fixed" | "left" | "failed"
  state       String    @default("open") @db.VarChar(8)
  choice      String?   @db.VarChar(24)
  decidedBy   String?
  decidedAt   DateTime?
  error       String?   @db.Text

  run SwapDiagnosticRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, kind])
}

/// An issue marked resolved and left as is: later runs don't raise it again
/// while both sides hold these values. Kept apart from the issues, which are
/// pruned with their runs, so a hide lasts as long as the swap.
model SwapDiagnosticHidden {
  id          String   @id @default(cuid())
  swapId      String
  sku         String
  kind        String   @db.VarChar(16)
  field       String   @default("") @db.VarChar(8)
  fingerprint String   @db.VarChar(64)
  hiddenBy    String?
  hiddenAt    DateTime @default(now())

  swap SkiSwap @relation(fields: [swapId], references: [id], onDelete: Cascade)

  @@unique([swapId, sku, kind, field, fingerprint])
}

// ─── Binding indemnification (Plan 44) ───────────────────────────────────────

/// A maker's indemnification program: who stands behind a list of bindings,
/// and on what terms. Eight today: amer, elan, elevate, fischer, head_tyrolia,
/// kneebinding, rossignol, vtec. Seeded by the migration; the notes are edited
/// in Platform Admin → Bindings, and `latestSeason` is set by each import.
model BindingIndemnificationProgram {
  key          String   @id @db.VarChar(40)
  name         String   @db.VarChar(120)
  /// The terms in a few paragraphs: dealer agreement needed, exclusions,
  /// deadlines. Shown with every answer from this program.
  notes        String   @db.Text
  /// The newest season this program has entries for ("2025-26"). A model with
  /// no entry for it reads as lapsed (D4). Per program rather than platform-
  /// wide, so a brand whose sheet arrives late doesn't look lapsed.
  latestSeason String?  @db.VarChar(7)
  updatedAt    DateTime @updatedAt
  updatedById  String?

  entries BindingIndemnification[]
}

/// One run of the seasonal import: what file, which season, what it did.
model BindingIndemnificationImport {
  id          String   @id @default(cuid())
  season      String   @db.VarChar(7)
  fileName    String?  @db.VarChar(191)
  /// The D8 counts: minted, new, changed, unchanged, lapsing.
  counts      Json
  createdAt   DateTime @default(now())
  createdById String?

  entries BindingIndemnification[]
}

enum BindingIndemnificationStatus {
  /// On the list for this season.
  LISTED
  /// On the list, and the maker says this is the last season it will be.
  FINAL_SEASON
}

enum BindingIndemnificationSource {
  /// From the NSSRA combined list, published for its members only (D5).
  NSSRA
  /// From a sheet the manufacturer published itself. Shown to every org.
  MANUFACTURER
}

/// One season's entry for one binding model (D2). The model is a VALUE node
/// under Bindings › Type › Skis › Manufacturer › Model; the entry says it was
/// on its program's list that season, in which lines, and where that was read.
/// Seasons accumulate: nothing is overwritten by the next import, so "last
/// listed 2023-24" is answerable and an answer can be traced to a page.
model BindingIndemnification {
  id         String                       @id @default(cuid())
  nodeId     String
  programKey String                       @db.VarChar(40)
  /// "2025-26". Sorts as text.
  season     String                       @db.VarChar(7)
  status     BindingIndemnificationStatus @default(LISTED)
  /// Which of the maker's lines listed it. All false when the list didn't say.
  retail     Boolean                      @default(false)
  rental     Boolean                      @default(false)
  demo       Boolean                      @default(false)
  /// Still in the maker's current line, or an older model still covered.
  /// Null when the list didn't distinguish.
  currentLine Boolean?
  /// Marker's "Non ISO Certified" column: touring bindings, still indemnified.
  nonIso     Boolean                      @default(false)
  source     BindingIndemnificationSource
  /// "Combined list p.35", "Marker retail sheet".
  sourceRef  String?                      @db.VarChar(191)
  note       String?                      @db.VarChar(500)
  importId   String?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  /// Restrict: an entry is a use of the node, as an item's answer is (D9).
  node    TaxonomyNode                  @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  program BindingIndemnificationProgram @relation(fields: [programKey], references: [key])
  import  BindingIndemnificationImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([nodeId, season])
  @@index([programKey, season])
  @@index([importId])
}
