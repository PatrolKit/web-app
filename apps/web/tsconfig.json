{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["web-bluetooth", "vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // Set here, not inherited: `baseUrl` in tsconfig.base.json resolves against
    // that file's directory (the repo root), which made the alias below point at
    // /api/src/contracts. It had no users, so nothing had caught it.
    "baseUrl": ".",
    "paths": {
      "@patrolkit/contracts/*": ["../api/src/contracts/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
