{
  "name": "patrolkit",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "infra:deploy": "pnpm --filter infra cdk deploy --all --require-approval never",
    "infra:synth": "pnpm --filter infra cdk synth",
    "infra:diff": "pnpm --filter infra cdk diff",
    "image:build": "docker build -t patrolkit:latest -f apps/api/Dockerfile .",
    "image:push": "node scripts/image-push.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
